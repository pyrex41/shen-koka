(defun shen-koka.original-triple-stack (V814 V815 V816 V817) (cond ((and (= () V815) (and (= () V816) (and (cons? V817) (and (= where (hd V817)) (and (cons? (tl V817)) (and (cons? (tl (tl V817))) (= () (tl (tl (tl V817)))))))))) (shen.triple-stack (cons (hd (tl V817)) V814) () () (hd (tl (tl V817))))) ((and (= () V815) (= () V816)) (cons (shen.rectify-test (reverse V814)) (cons V817 ()))) ((and (cons? V815) (and (cons? V816) (variable? (hd V815)))) (shen.triple-stack V814 (tl V815) (tl V816) (shen.beta (hd V815) (hd V816) V817))) ((and (cons? V815) (and (cons? (hd V815)) (and (cons? (tl (hd V815))) (and (cons? (tl (tl (hd V815)))) (and (= () (tl (tl (tl (hd V815))))) (cons? V816)))))) (shen.triple-stack (cons (cons (shen.op-test (hd (hd V815))) (cons (hd V816) ())) V814) (cons (hd (tl (hd V815))) (cons (hd (tl (tl (hd V815)))) (tl V815))) (cons (cons (shen.op1 (hd (hd V815))) (cons (hd V816) ())) (cons (cons (shen.op2 (hd (hd V815))) (cons (hd V816) ())) (tl V816))) (shen.beta (hd V815) (hd V816) V817))) ((and (cons? V815) (cons? V816)) (shen.triple-stack (cons (cons = (cons (hd V815) (cons (hd V816) ()))) V814) (tl V815) (tl V816) V817)) (true (simple-error "implementation error in shen.triple-stack"))))

(defun shen.compile-pattern-fragment (P)
  (shen.<-out (shen.<pattern> (cons P ()))))

(defun shen.<pattern> (Input)
  (let Hook (trap-error (value shen.*custom-pattern-compiler*) (lambda E shen.fail!))
    (if (= Hook shen.fail!)
        (shen-koka.original-<pattern> Input)
        (if (cons? Input)
            (let Compiled (Hook (hd Input) (freeze shen.fail!))
              (if (= Compiled shen.fail!)
                  (shen-koka.original-<pattern> Input)
                  (shen.comb (tl Input) Compiled)))
            (shen-koka.original-<pattern> Input)))))

(defun shen-koka.custom-pattern? (P)
  (and (cons? P)
       (and (= (hd P) @p)
            (and (cons? (tl P)) (= (hd (tl P)) shen.custom-pattern)))))

(defun shen.triple-stack (Tests Patterns Selectors Body)
  (if (and (cons? Patterns)
           (and (cons? Selectors) (shen-koka.custom-pattern? (hd Patterns))))
      (let Pattern (hd Patterns)
        (let Self (hd Selectors)
          (let Reduced ((value shen.*custom-pattern-reducer*)
                        (@p (hd (tl (tl Pattern))) Self))
            (if (= Reduced shen.fail!)
                (simple-error "custom pattern reducer rejected a compiled pattern")
                (shen.triple-stack
                  (append (reverse (fst Reduced)) Tests)
                  (append (map (lambda X (fst X)) (snd Reduced)) (tl Patterns))
                  (append (map (lambda X (snd X)) (snd Reduced)) (tl Selectors))
                  (shen.beta Pattern Self Body))))))
      (shen-koka.original-triple-stack Tests Patterns Selectors Body)))
