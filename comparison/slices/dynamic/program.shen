\\ Runtime evaluation, redefinition, typechecking, and file loading in a slice.
(output "eval-list: ~A~%" (eval [+ 20 22]))
(eval [define dynamic-scale X -> [* 3 X]])
(output "define: ~A~%" (eval [dynamic-scale 14]))
(eval [define dynamic-scale X -> [* 2 X]])
(output "redefine: ~A~%" (eval [dynamic-scale 21]))
(output "read-eval: ~A~%" (eval (hd (read-from-string "(+ 40 2)"))))
(tc +)
(eval (hd (read-from-string "(define dynamic-typed {number --> number} X -> (+ X 1))")))
(output "typed: ~A~%" (eval [dynamic-typed 41]))
(tc -)
(let S (open "runtime-loaded.shen" out)
  (do (pr "(define dynamic-loaded X -> (* 3 X))" S) (close S)))
(let Saved (stoutput)
  (let Log (open "load-output.txt" out)
    (do (set *stoutput* Log)
        (do (load "runtime-loaded.shen")
            (do (set *stoutput* Saved) (close Log))))))
(output "load: ~A~%" (eval [dynamic-loaded 14]))
